# Build de produção (npm run build): interface publicada pelo Apache em
# https://batcaverna.site/gradeif/ e API em https://batcaverna.site/api-gradeif.
# Sem segredos: estes valores vão para o código do navegador.

# Pasta da interface no servidor (com barras no início e no fim).
VITE_BASE=/gradeif/

# Prefixo das chamadas à API, na mesma origem (o Apache faz o proxy reverso
# de /api-gradeif para a API Node, que atende em /api).
VITE_API_BASE=/api-gradeif/api

# Para a API Node servir a própria interface (FRONTEND_DIST, ver
# docs/implantacao.md), use VITE_BASE=/ e VITE_API_BASE=/api.
