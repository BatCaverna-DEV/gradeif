# GradeIF: interface (Vue) servida pelo Apache em /gradeif/.
# Vai para o build (frontend/dist) e é copiado junto para /var/www/html/gradeif.
# Requer AllowOverride All na pasta e os módulos rewrite e headers.
# Se a pasta mudar, ajuste o RewriteBase e o VITE_BASE de frontend/.env.production.

Options -Indexes -MultiViews
DirectoryIndex index.html

# Não expõe este arquivo, mesmo que o servidor não bloqueie .ht* por padrão.
<Files ".htaccess">
  Require all denied
</Files>

# ---------- Rotas do Vue Router ----------
# /gradeif/editor, /gradeif/consulta/... não existem como arquivo: todas
# recebem o index.html, e o Vue Router mostra a tela certa.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /gradeif/

  # Arquivos e pastas que existem (index.html, assets, favicon...) saem direto.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Arquivo de build que não existe mais (ex.: aba aberta antes de uma
  # atualização) deve dar 404, e não o index.html com tipo errado.
  RewriteRule ^assets/ - [R=404,L]

  RewriteRule ^ index.html [L]
</IfModule>

# ---------- Cache ----------
<IfModule mod_headers.c>
  # O index.html nunca fica em cache: assim cada publicação aparece na hora.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Os arquivos de assets/ têm o hash no nome: podem ficar em cache por um ano.
  <If "%{REQUEST_URI} =~ m#/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---------- Compressão ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript text/javascript application/json image/svg+xml
</IfModule>

# ---------- Tipos de arquivo ----------
AddType application/javascript .js .mjs
AddType image/webp .webp
AddType font/woff2 .woff2
AddType font/woff .woff
