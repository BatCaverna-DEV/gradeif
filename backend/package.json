{
  "name": "@horarios/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "API Express e núcleo de regras/solver do Sistema de Horários",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:make": "knex migrate:make",
    "seed": "knex seed:run",
    "modelos": "node scripts/gerar-modelos.js",
    "resolver": "node scripts/resolver.js",
    "exportar-problema": "node scripts/exportar-problema.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "knex": "^3.1.0",
    "multer": "^2.5.0",
    "mysql2": "^3.15.3",
    "pdfmake": "^0.3.14",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.1",
    "supertest": "^7.1.4",
    "vitest": "^5.1.0"
  }
