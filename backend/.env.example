# Copie para .env e ajuste. Nenhum valor aqui é segredo real.
NODE_ENV=development
PORT=3333
LOG_LEVEL=info

# Origem do frontend em desenvolvimento (Vite)
CORS_ORIGIN=http://localhost:5173

# Segredo da sessão (troque em produção)
SESSION_SECRET=troque-este-segredo

# MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=horarios

# Usuário gestor criado pelo seed inicial
GESTOR_NOME=Gestor de Horários
GESTOR_EMAIL=gestor@horarios.local
GESTOR_SENHA=trocar123

# Produção: pasta do build do Vue para a API servir a interface (ver docs/implantacao.md)
# FRONTEND_DIST=/srv/horarios/frontend/dist
